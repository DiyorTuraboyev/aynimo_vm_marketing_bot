# Copy this file to ".env" and fill in the values.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Product photos server
BASE_IMAGE_URL=https://media.aynimo.uz:8085/
WEBDAV_USER=webdav
WEBDAV_PASSWORD=

# The ONE group where all VM + Marketing products are posted (send /chatid in the group).
GROUP_CHAT_ID=
# Optional: send VM or Marketing to a different chat instead of the group.
VM_CHAT_ID=
MARKETING_CHAT_ID=

# Telegram user IDs, comma separated (each person sends /chatid to the bot to see their ID).
# ADMIN_IDS: may upload the Excel and send. Empty = everyone.
ADMIN_IDS=
# Who may press "✅ Bajarildi": VM posts -> VM team, Marketing posts -> Marketing team.
# Empty list = anybody in the group may confirm that department's posts.
VM_TEAM_IDS=
MARKETING_TEAM_IDS=

# Weekly report (sent to GROUP_CHAT_ID unless REPORT_CHAT_ID is set)
WEEKLY_REPORT=1
REPORT_DAY=sunday
REPORT_TIME=18:00
REPORT_CHAT_ID=
TIMEZONE=Asia/Tashkent

# Monday morning: re-send last week's report, then delete last week's product posts from the group.
# (Reports are never deleted.) The bot must be a group ADMIN with "Delete messages" permission.
WEEKLY_CLEANUP=1
CLEANUP_DAY=monday
CLEANUP_TIME=09:00

# Optional
VM_EXCEL_FILE=VM_MARKETING TEMPLATE.xlsx
# Seconds between posts. 3 = Telegram's group limit (~20/min); the bot slows down by itself if needed.
VM_SEND_DELAY=3
VM_DONE_BUTTON=1
